# Generated research data — never commit these.
# Participant observations and exports belong in an access-controlled store,
# not in git history. Deleting a file later does not remove it from the log.
data/
*.xlsx
observations*.json
observations*.jsonl
datasets/
exports/

# Local configuration
.env
.env.*
!.env.example

# Secrets generated by run.sh. Never commit these: anyone holding
# FINGERPRINT_SALT can recompute every visitor ID from a candidate signal set.
secrets.txt

# GeoLite2 databases are licensed separately and not redistributable.
*.mmdb

# Runtime
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.log

# Playwright browser downloads live outside the project, but keep the
# screenshot directories out if anyone points it at the repo root.
test-results/
.playwright/

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
dist/
